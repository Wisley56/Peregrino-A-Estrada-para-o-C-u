{
  "name": "peregrino-a-estrada-para-o-ceu",
  "private": true,
  "version": "0.1.0",
  "description": "Peregrino: A Estrada para o Céu. Aventura 3D em voxels para a web (Three.js).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/verificar-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fauna": "node tools/fauna-veloren.mjs",
    "icone": "node tools/gerar-icone.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fumaca": "playwright test"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "inkjs": "2.4.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/three": "0.180.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "6.4.6",
    "vitest": "^3.2.7"
  }
}
